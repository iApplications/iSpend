<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="iSpend" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_today_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RM 0.00" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="QUICK ADD" android:textColor="#B9F6EE" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_favorite_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_secondary_action" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingHorizontal="10dp" android:textColor="#E8FFFB" android:textSize="13sp" android:visibility="gone" />
        <TextView android:id="@+id/widget_favorite_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/widget_secondary_action" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingHorizontal="10dp" android:textColor="#E8FFFB" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/widget_favorite_3" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_more" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:text="More ›" android:textColor="#D5FFF7" android:textSize="12sp" android:visibility="gone" />
    <TextView android:id="@+id/widget_add" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="8dp" android:background="@drawable/widget_primary_action" android:gravity="center" android:text="+ Add Expense" android:textColor="#075B62" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
