<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="iSpend" android:textStyle="bold" android:textSize="18sp" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/widget_today_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="TODAY" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" android:textColor="#B9F6EE" />
    <TextView android:id="@+id/widget_today_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="RM 0.00" android:textSize="25sp" android:textStyle="bold" android:textColor="#FFFFFF" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="QUICK ADD" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.1" android:textColor="#B9F6EE" />
    <TextView android:id="@+id/widget_favorite_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/widget_secondary_action" android:gravity="center_vertical" android:minHeight="34dp" android:paddingHorizontal="12dp" android:textColor="#E8FFFB" android:textSize="13sp" android:visibility="gone" />
    <TextView android:id="@+id/widget_favorite_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/widget_secondary_action" android:gravity="center_vertical" android:minHeight="34dp" android:paddingHorizontal="12dp" android:textColor="#E8FFFB" android:textSize="13sp" android:visibility="gone" />
    <TextView android:id="@+id/widget_favorite_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/widget_secondary_action" android:gravity="center_vertical" android:minHeight="34dp" android:paddingHorizontal="12dp" android:textColor="#E8FFFB" android:textSize="13sp" android:visibility="gone" />
    <TextView android:id="@+id/widget_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="More ›" android:textColor="#D5FFF7" android:textSize="12sp" android:visibility="gone" />
    <TextView android:id="@+id/widget_add" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/widget_primary_action" android:gravity="center" android:minHeight="44dp" android:text="+ Add Expense" android:textColor="#075B62" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
